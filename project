#!/bin/bash

set -e

if [[ -z $2 ]]; then
    echo "project not found!"
    exit 1
fi

# Thư mục chứa file server
BASE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Thư mục docker-system
DOCKER_DIR="$BASE_DIR/docker-projects/$2"

# Kiểm tra tồn tại
if [ ! -f "$DOCKER_DIR/docker-compose.yml" ]; then
    echo "docker-compose.yml not found!"
    exit 1
fi

case "$1" in
    start)
        docker-compose -f "$DOCKER_DIR/docker-compose.yml" start
        ;;
    stop)
        docker-compose -f "$DOCKER_DIR/docker-compose.yml" stop
        ;;
    restart)
        docker-compose -f "$DOCKER_DIR/docker-compose.yml" restart
        ;;
    up)
        docker-compose -f "$DOCKER_DIR/docker-compose.yml" up -d
        ;;
    down)
        docker-compose -f "$DOCKER_DIR/docker-compose.yml" down
        ;;
    ps)
        docker-compose -f "$DOCKER_DIR/docker-compose.yml" ps
        ;;
    logs)
        docker-compose -f "$DOCKER_DIR/docker-compose.yml" logs -f
        ;;
    *)
        echo "Usage: server {up|down|start|stop|restart|ps|logs}"
        exit 1
        ;;
esac